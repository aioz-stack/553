# mobile2 → the Laravel backend (API + Reverb). Copy to .env and fill in.
# Values are baked into the app at build time (EXPO_PUBLIC_*), so rebuild after changing them.
#
# Android emulator → Laravel on this PC:  10.0.2.2 is the emulator's name for your PC's localhost.
#   php artisan serve --host=0.0.0.0 --port=8000
#   php artisan reverb:start --host=0.0.0.0 --port=8080
# Real phone → your server: use the public https domain and Reverb on 443 (wss through the proxy).

EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Must match Laravel's REVERB_APP_KEY / host / port / scheme.
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=10.0.2.2
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# Production example:
# EXPO_PUBLIC_API_URL=https://test.asperioscents.com
# EXPO_PUBLIC_REVERB_HOST=test.asperioscents.com
# EXPO_PUBLIC_REVERB_PORT=443
# EXPO_PUBLIC_REVERB_SCHEME=https
