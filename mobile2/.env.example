# mobile2 → the Laravel backend (API + Reverb). Copy to .env and fill in.
# Values are baked into the app at build time (app/build.gradle.kts), so rebuild after changing them.
# The old EXPO_PUBLIC_* names from the React Native app are still accepted.
#
# Android emulator → Laravel on this PC: 10.0.2.2 is the emulator's name for your PC's localhost.
#   php artisan serve --host=0.0.0.0 --port=8000
#   php artisan reverb:start --host=0.0.0.0 --port=8080
# Real phone → your server: use the public https domain and Reverb on 443 (wss through the proxy).

API_URL=http://10.0.2.2:8000

# Must match Laravel's REVERB_APP_KEY / host / port / scheme.
REVERB_APP_KEY=
REVERB_HOST=10.0.2.2
REVERB_PORT=8080
REVERB_SCHEME=http

# Production example:
# API_URL=https://your-domain.example
# REVERB_HOST=your-domain.example
# REVERB_PORT=443
# REVERB_SCHEME=https
