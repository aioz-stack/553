# Production environment template (aaPanel / Ubuntu). Copy to .env on the
# server and fill every <...>. Never commit the real .env.

APP_NAME="Pusoy 13"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://<your-domain>
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<db-user-not-root>
DB_PASSWORD=<strong-password>

# Redis (bound to 127.0.0.1 only; requirepass set)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<redis-password>
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=<your-domain>

BROADCAST_CONNECTION=reverb

# Reverb listens privately on 127.0.0.1:8080; Nginx proxies wss://<ws-domain>/app → it.
REVERB_APP_ID=<id>
REVERB_APP_KEY=<key>
REVERB_APP_SECRET=<secret>
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=<ws-domain e.g. ws.your-domain>
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SCALING_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Sanctum: only the web app's own domain is stateful. The mobile app uses bearer tokens.
SANCTUM_STATEFUL_DOMAINS=<your-domain>
# Capacitor origins (iOS capacitor://localhost, Android https://localhost) + your web domain
CORS_ALLOWED_ORIGINS=https://<your-domain>,capacitor://localhost,https://localhost

MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Cash-related features MUST stay false until Philippine legal, regulatory and
# payment-provider approvals have been obtained.
FEATURE_CASH_DEPOSITS=false
FEATURE_CASH_WITHDRAWALS=false
FEATURE_CP_WAGERING=false
FEATURE_CP_COMMISSION_PAYOUTS=false

GAME_ARRANGEMENT_SECONDS=90
GAME_READY_TIMEOUT_SECONDS=60
GAME_DISCONNECT_AFTER_SECONDS=30
PRIVATE_ROOM_PAYOUT_MODE=winner_takes_all

# Keep READ COMMITTED (required by the ledger/seating locking; see DEVELOPMENT.md)
DB_ISOLATION_LEVEL="READ COMMITTED"

# Reverb: only these origins may open websocket connections
REVERB_ALLOWED_ORIGINS=https://<your-domain>,capacitor://localhost,https://localhost

# Push notifications (Firebase Cloud Messaging HTTP v1). Leave empty to disable.
FCM_PROJECT_ID=
FCM_CREDENTIALS=/www/secure/pusoy13-firebase.json
