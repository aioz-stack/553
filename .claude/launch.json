{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "reverb",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "reverb:start",
        "--host=0.0.0.0",
        "--port=8080",
        "--debug"
      ],
      "port": 8080
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mobile-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "dev"
      ],
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8000",
        "NEXT_PUBLIC_REVERB_APP_KEY": "ep3ndrkpnopub9ueyuy8",
        "NEXT_PUBLIC_REVERB_HOST": "localhost",
        "NEXT_PUBLIC_REVERB_PORT": "8080",
        "NEXT_PUBLIC_REVERB_SCHEME": "http"
      },
      "port": 3000
    }
  ]
}