# Laravel backend (the single source of truth). Use your LAN IP when testing
# on a physical phone, e.g. http://192.168.1.20:8000. Production: https://your-domain
NEXT_PUBLIC_API_URL=http://localhost:8000

# Laravel Reverb (must match the backend's REVERB_* values)
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Set to true only after adding android/app/google-services.json (and the APNs
# key in Firebase for iOS). Without Firebase, push registration crashes Android.
NEXT_PUBLIC_PUSH_ENABLED=false
