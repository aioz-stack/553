# Backend the Android / iOS app (APK) talks to. Used by `npm run build:native` and
# `npm run cap:sync` ONLY — `npm run dev` keeps using .env.local (your local backend).
# A phone cannot reach "localhost" (that is the phone itself), so this must be the public server.
NEXT_PUBLIC_API_URL=https://test.asperioscents.com

# Laravel Reverb on the server (must match the server's REVERB_* values).
NEXT_PUBLIC_REVERB_APP_KEY=d41f8f854966a709c20a54e23cd00ad3
NEXT_PUBLIC_REVERB_HOST=test.asperioscents.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# Set to true only after adding android/app/google-services.json (and the APNs
# key in Firebase for iOS). Without Firebase, push registration crashes Android.
NEXT_PUBLIC_PUSH_ENABLED=false
